  "semantic": {
    "fg": {
      "group": "text",
      "light": "night.900",
      "dark": "paper.50",
      "use": "Primary text and icons",
      "on": "surface"
    },
    "fg-secondary": {
      "group": "text",
      "light": "night.700",
      "dark": "paper.200",
      "use": "Secondary text, menu items, secondary buttons",
      "on": "surface"
    },
    "fg-muted": {
      "group": "text",
      "light": "night.500",
      "dark": "paper.300",
      "use": "Inactive tabs, supporting copy",
      "on": "surface"
    },
    "fg-subtle": {
      "group": "text",
      "light": "night.500",
      "dark": "night.400",
      "use": "Help text, field icons",
      "on": "surface"
    },
    "fg-placeholder": {
      "group": "text",
      "light": "night.500",
      "dark": "night.400",
      "use": "Placeholder and disabled text",
      "on": "surface"
    },
    "surface": {
      "group": "surface",
      "light": "paper.0",
      "dark": "night.900",
      "use": "Default component background"
    },
    "surface-subtle": {
      "group": "surface",
      "light": "paper.50",
      "dark": "night.800",
      "use": "Hover on default surfaces"
    },
    "surface-raised": {
      "group": "surface",
      "light": "paper.100",
      "dark": "night.800",
      "use": "Tab track, toast, chip buttons"
    },
    "surface-hover": {
      "group": "surface",
      "light": "paper.200",
      "dark": "night.700",
      "use": "Hover on raised surfaces"
    },
    "surface-elevated": {
      "group": "surface",
      "light": "paper.0",
      "dark": "night.700",
      "use": "Active tab pill"
    },
    "fill": {
      "group": "surface",
      "light": "night.900/5",
      "dark": "paper.0/5",
      "use": "Input prefix, subtle wells"
    },
    "line": {
      "group": "border",
      "light": "night.900/10",
      "dark": "paper.0/10",
      "use": "Default borders"
    },
    "line-hover": {
      "group": "border",
      "light": "paper.300",
      "dark": "night.600",
      "use": "Border on hover"
    },
    "line-strong": {
      "group": "border",
      "light": "night.900/50",
      "dark": "night.400",
      "use": "Focused and open borders",
      "on": "surface"
    },
    "popover": {
      "group": "surface",
      "light": "night.800",
      "dark": "night.800",
      "use": "Menus and popovers (dark in both themes)"
    },
    "brand": {
      "group": "brand",
      "light": "tabs-blue.450",
      "dark": "tabs-blue.base",
      "use": "Primary actions, selection"
    },
    "brand-hover": {
      "group": "brand",
      "light": "tabs-blue.500",
      "dark": "tabs-blue.300",
      "use": "Primary action hover"
    },
    "on-brand": {
      "group": "brand",
      "light": "paper.0",
      "dark": "paper.0",
      "use": "Text on brand and danger fills",
      "on": "brand"
    },
    "danger": {
      "group": "status",
      "light": "error.600",
      "dark": "error.400",
      "use": "Error borders, icons, help text",
      "on": "surface"
    },
    "danger-strong": {
      "group": "status",
      "light": "error.600",
      "dark": "error.400",
      "use": "Error labels and text",
      "on": "surface"
    },
    "danger-fill": {
      "group": "status",
      "light": "error.600",
      "dark": "error.500",
      "use": "Destructive button fill (white text)",
      "on": "on-brand"
    },
    "danger-subtle": {
      "group": "status",
      "light": "error.50",
      "dark": "error.950",
      "use": "Soft destructive button"
    },
    "on-danger-subtle": {
      "group": "status",
      "light": "error.700",
      "dark": "error.200",
      "use": "Text on soft destructive",
      "on": "danger-subtle"
    },
    "danger-surface": {
      "group": "status",
      "light": "error.50",
      "dark": "error.950/40",
      "use": "Error field and error toast background"
    },
    "success": {
      "group": "status",
      "light": "success.700",
      "dark": "success.400",
      "use": "Success icons and text",
      "on": "surface"
    },
    "fill-strong": {
      "group": "surface",
      "light": "night.900/10",
      "dark": "paper.0/10",
      "use": "Disabled secondary button fill"
    },
    "danger-fill-hover": {
      "group": "status",
      "light": "error.700",
      "dark": "error.600",
      "use": "Destructive button hover"
    },
    "danger-subtle-hover": {
      "group": "status",
      "light": "error.100",
      "dark": "error.950/80",
      "use": "Soft destructive button hover"
    },
    "success-subtle": {
      "group": "status",
      "light": "success.50",
      "dark": "success.950",
      "use": "Background of success toasts and messages"
    },
    "success-subtle-hover": {
      "group": "status",
      "light": "success.100",
      "dark": "success.950/80",
      "use": "Hover on a success background"
    },
    "on-success-subtle": {
      "group": "status",
      "light": "success.700",
      "dark": "success.400",
      "use": "Text on a success background",
      "on": "success-subtle"
    },
    "fill-disabled": {
      "group": "surface",
      "light": "paper.100",
      "dark": "night.800",
      "use": "Background of any disabled control"
    },
    "fg-disabled": {
      "group": "text",
      "light": "night.500",
      "dark": "night.400",
      "use": "Text and icons on a disabled control",
      "on": "fill-disabled"
    },
    "on-popover": {
      "group": "text",
      "light": "paper.0",
      "dark": "paper.0",
      "use": "Text and icons on a menu",
      "on": "popover"
    },
    "on-popover-muted": {
      "group": "text",
      "light": "paper.300",
      "dark": "paper.300",
      "use": "Secondary text on a menu",
      "on": "popover"
    }
  },
  "$semantic": "Tokens named by purpose, each pointing at a palette step for light and dark (\"family.step\", optionally \"/alpha\"). Components use only these. on = the token its contrast is checked against.",
