  "semantic": {
    "fg": {
      "group": "text",
      "light": "gray.900",
      "dark": "gray.50",
      "use": "Primary text and icons",
      "on": "surface"
    },
    "fg-secondary": {
      "group": "text",
      "light": "gray.700",
      "dark": "gray.200",
      "use": "Secondary text, menu items, secondary buttons",
      "on": "surface"
    },
    "fg-muted": {
      "group": "text",
      "light": "gray.500",
      "dark": "gray.300",
      "use": "Inactive tabs, supporting copy",
      "on": "surface"
    },
    "fg-subtle": {
      "group": "text",
      "light": "gray.400",
      "dark": "gray.400",
      "use": "Help text, field icons",
      "on": "surface"
    },
    "fg-placeholder": {
      "group": "text",
      "light": "gray.300",
      "dark": "gray.400",
      "use": "Placeholder and disabled text",
      "on": "surface"
    },
    "surface": {
      "group": "surface",
      "light": "gray.0",
      "dark": "gray.900",
      "use": "Default component background"
    },
    "surface-subtle": {
      "group": "surface",
      "light": "gray.50",
      "dark": "gray.800",
      "use": "Hover on default surfaces"
    },
    "surface-raised": {
      "group": "surface",
      "light": "gray.100",
      "dark": "gray.800",
      "use": "Tab track, toast, chip buttons"
    },
    "surface-hover": {
      "group": "surface",
      "light": "gray.200",
      "dark": "gray.700",
      "use": "Hover on raised surfaces"
    },
    "surface-elevated": {
      "group": "surface",
      "light": "gray.0",
      "dark": "gray.700",
      "use": "Active tab pill"
    },
    "fill": {
      "group": "surface",
      "light": "gray.900/5",
      "dark": "gray.0/5",
      "use": "Input prefix, subtle wells"
    },
    "line": {
      "group": "border",
      "light": "gray.900/10",
      "dark": "gray.0/10",
      "use": "Default borders"
    },
    "line-hover": {
      "group": "border",
      "light": "gray.300",
      "dark": "gray.600",
      "use": "Border on hover"
    },
    "line-strong": {
      "group": "border",
      "light": "gray.900/50",
      "dark": "gray.400",
      "use": "Focused and open borders",
      "on": "surface"
    },
    "popover": {
      "group": "surface",
      "light": "gray.800",
      "dark": "gray.800",
      "use": "Menus and popovers (dark in both themes)"
    },
    "brand": {
      "group": "brand",
      "light": "tabs-blue.base",
      "dark": "tabs-blue.base",
      "use": "Primary actions, selection"
    },
    "brand-hover": {
      "group": "brand",
      "light": "tabs-blue.500",
      "dark": "tabs-blue.300",
      "use": "Primary action hover"
    },
    "on-brand": {
      "group": "brand",
      "light": "gray.0",
      "dark": "gray.0",
      "use": "Text on brand and danger fills",
      "on": "brand"
    },
    "danger": {
      "group": "status",
      "light": "error.500",
      "dark": "error.400",
      "use": "Error borders, icons, help text",
      "on": "surface"
    },
    "danger-strong": {
      "group": "status",
      "light": "error.600",
      "dark": "error.400",
      "use": "Error labels and text",
      "on": "surface"
    },
    "danger-fill": {
      "group": "status",
      "light": "error.600",
      "dark": "error.600",
      "use": "Destructive button fill (white text)",
      "on": "on-brand"
    },
    "danger-subtle": {
      "group": "status",
      "light": "error.50",
      "dark": "error.950",
      "use": "Soft destructive button"
    },
    "on-danger-subtle": {
      "group": "status",
      "light": "error.600",
      "dark": "error.200",
      "use": "Text on soft destructive",
      "on": "danger-subtle"
    },
    "danger-surface": {
      "group": "status",
      "light": "error.50",
      "dark": "error.950/40",
      "use": "Error field and error toast background"
    },
    "success": {
      "group": "status",
      "light": "success.600",
      "dark": "success.400",
      "use": "Success icons and text",
      "on": "surface"
    },
    "fill-strong": {
      "group": "surface",
      "light": "gray.900/10",
      "dark": "gray.0/10",
      "use": "Disabled secondary button fill"
    },
    "brand-disabled": {
      "group": "brand",
      "light": "gray.700",
      "dark": "gray.700",
      "use": "Disabled primary action fill"
    },
    "on-brand-disabled": {
      "group": "brand",
      "light": "gray.300",
      "dark": "gray.300",
      "use": "Text on a disabled primary action",
      "on": "brand-disabled"
    },
    "danger-fill-hover": {
      "group": "status",
      "light": "error.700",
      "dark": "error.700",
      "use": "Destructive button hover"
    },
    "danger-fill-disabled": {
      "group": "status",
      "light": "error.300",
      "dark": "error.950",
      "use": "Disabled destructive button fill"
    },
    "danger-subtle-hover": {
      "group": "status",
      "light": "error.100",
      "dark": "error.950/80",
      "use": "Soft destructive button hover"
    },
    "on-danger-subtle-disabled": {
      "group": "status",
      "light": "error.200",
      "dark": "error.700",
      "use": "Text on a disabled soft destructive button",
      "on": "danger-subtle"
    }
  },
